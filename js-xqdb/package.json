{
  "name": "@xbbg/xqdb",
  "version": "0.1.8",
  "description": "Typed Node.js bindings for q IPC backed by xqdb",
  "author": "XQDB contributors",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "native.cjs",
    "native.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:native": "napi build --manifest-path ../bindings/napi-xqdb/Cargo.toml --package-json-path ./package.json --output-dir . --platform --js native.cjs --dts native.d.ts",
    "build:native:release": "npm run build:native -- --profile node-release",
    "build:release": "npm run build:native:release && npm run build:ts",
    "build:ts": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p ../benchmarks/node/tsconfig.json",
    "lint": "cd .. && oxlint --config .oxlintrc.jsonc --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "format": "cd .. && oxfmt --write",
    "format:check": "cd .. && oxfmt --check",
    "check": "npm run build:ts && npm run lint && npm run format:check && npm run typecheck",
    "build": "npm run build:native && npm run build:ts",
    "create:npm-dirs": "napi create-npm-dirs",
    "artifacts": "napi artifacts --output-dir artifacts --npm-dir npm",
    "set-optional-deps": "node scripts/set-optional-deps.mjs",
    "prepublishOnly": "npm run build:release && napi prepublish -t npm",
    "pretest": "npm run build:ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run test/live-ipc.test.ts",
    "pretest:live": "npm run build:ts"
  },
  "napi": {
    "binaryName": "xqdb",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "dependencies": {
    "apache-arrow": "^21.2.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.4.1",
    "@types/node": "^22.17.0",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "q",
    "kdb+",
    "arrow",
    "napi-rs"
  ],
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/underloam/xqdb.git",
    "directory": "js-xqdb"
  },
  "publishConfig": {
    "access": "public"
  }
}
